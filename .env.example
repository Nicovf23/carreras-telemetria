# Copia este archivo como .env y rellena los valores. NUNCA subas .env al repositorio.

# --- Servidor ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Orígenes permitidos para CORS (separados por coma). En desarrollo, el frontend Vite.
CORS_ORIGINS=http://localhost:5173

# --- Base de datos ---
# Si DATABASE_URL está vacío se usa PGlite (PostgreSQL embebido, sin instalación),
# guardado en PGLITE_DIR. Para producción usa un PostgreSQL real:
# DATABASE_URL=postgres://usuario:contraseña@localhost:5432/carreras
DATABASE_URL=
PGLITE_DIR=./data/pglite

# --- Autenticación ---
# Secreto para firmar las sesiones (mínimo 32 caracteres aleatorios).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración de la sesión de administrador (horas)
SESSION_HOURS=12

# Administrador inicial: solo se crea si no existe ningún usuario.
# Tras el primer arranque puedes borrar estas dos líneas.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Telemetría ---
# Tolerancia para marcas temporales en el futuro (segundos) por desfase de reloj del dispositivo
TELEMETRY_MAX_FUTURE_SKEW_S=30
# Antigüedad máxima aceptada para datos almacenados en el dispositivo (horas)
TELEMETRY_MAX_AGE_H=48

# --- Modo DEMO ---
# Crea la carrera de demostración (datos ficticios, marcada como DEMO) al arrancar
DEMO_SEED=true
# Arranca automáticamente la simulación al iniciar el servidor
DEMO_AUTOSTART=true
# Multiplicador de velocidad del reloj simulado (1 = tiempo real)
DEMO_SPEED=10
